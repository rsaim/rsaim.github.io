{
  "name": "rsaim.github.io portfolio",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "workspaceFolder": "/workspaces/rsaim.github.io",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "React dev server", "visibility": "private" }
  },
  "mounts": [
    "source=claude-config,target=/home/node/.claude,type=volume"
  ],
  "postCreateCommand": "sudo chown -R $(whoami):$(whoami) /home/node/.claude && bash setup.sh claude && bash setup.sh gh && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "dsznajder.es7-react-js-snippets",
        "anthropic.claude-code"
      ]
    }
  }
}
