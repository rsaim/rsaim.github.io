# Copy this to .env and fill in real values. .env is git-ignored — never commit it.
# Automatically created for you (from this file) the first time you run
# npm start / npm run build / npm test, via scripts/ensure-local-config.js.

# Static SEO strings injected into public/index.html at build time.
REACT_APP_SITE_TITLE=Your Name | Portfolio
REACT_APP_SITE_DESCRIPTION=Personal portfolio built with React.

# EmailJS (https://www.emailjs.com/) — powers the contact form.
# See CONTACT_IMPLEMENTATION_GUIDE.md for setup steps.
REACT_APP_EMAILJS_SERVICE_ID=your_service_id_here
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id_here
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_here
